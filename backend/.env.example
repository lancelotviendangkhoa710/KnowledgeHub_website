APP_NAME=KnowledgeHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

BROADCAST_DRIVER=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=30
# Web hosts that get a cookie session (AUTH-06); add the real web host when deploying.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# AUTH-07 Google sign-in. Keep CLIENT_ID and CLIENT_SECRET EMPTY in this template: put the real values
# only in your own private backend/.env (see docs/DEV_CHEATSHEET.md to create them).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Email domains allowed to CREATE an account through Google (*.edu = any domain ending in .edu; empty = no limit).
GOOGLE_ALLOWED_DOMAINS=*.edu,*.edu.vn
GOOGLE_REQUIRE_AUTHORITATIVE_EMAIL=true
GOOGLE_MAX_NEW_ACCOUNTS_PER_IP=3
GOOGLE_MAX_NEW_ACCOUNTS_PER_HOUR=30
# Only when a trusted edge proxy (nginx, load balancer) sets X-Forwarded-For: its addresses, comma separated.
# Never list the Next.js /api proxy. Must be a real process environment variable when config is cached.
TRUSTED_PROXIES=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@knowledgehub.local"
MAIL_FROM_NAME="${APP_NAME}"
# Deployed (Render): Brevo SMTP on port 2525 (Render free blocks 25/465/587); MAIL_PASSWORD is the Brevo SMTP key.
# MAIL_HOST=smtp-relay.brevo.com  MAIL_PORT=2525  MAIL_USERNAME=<brevo-smtp-login>  MAIL_PASSWORD=<brevo-smtp-key>
# MAIL_FROM_ADDRESS must be a sender confirmed in Brevo. See docs/DEPLOYMENT.md.

# AUTH-08 links inside emails (web host, no trailing slash). Deployed: the Vercel URL.
FRONTEND_URL=http://localhost:3000
# AUTH-08 Cloudflare Turnstile. These are Cloudflare's public always-pass TEST keys (development only);
# put the real secret only in Render. The site key goes in frontend env NEXT_PUBLIC_TURNSTILE_SITE_KEY
# (test value 1x00000000000000000000AA).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TOKEN=
AI_AGENTS_ENABLED=false
AI_AGENT_COURSES_ENABLED=false
AI_AGENT_ADMIN_ENABLED=false
AI_AGENT_CV_ENABLED=false
AI_CV_RAG_ENABLED=false
AI_CV_RAG_SIMILARITY_THRESHOLD=0.72
CV_STORAGE_DRIVER=s3
YOUTUBE_API_KEY=
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-flash

VITE_APP_NAME="${APP_NAME}"

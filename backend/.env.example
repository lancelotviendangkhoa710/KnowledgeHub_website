APP_NAME=KnowledgeHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

BROADCAST_DRIVER=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=30
# Web hosts that get a cookie session (AUTH-06); add the real web host when deploying.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# AUTH-07 Google sign-in. Keep CLIENT_ID and CLIENT_SECRET EMPTY in this template: put the real values
# only in your own private backend/.env (see docs/DEV_CHEATSHEET.md to create them).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Email domains allowed to CREATE an account through Google (*.edu = any domain ending in .edu; empty = no limit).
GOOGLE_ALLOWED_DOMAINS=*.edu,*.edu.vn
GOOGLE_REQUIRE_AUTHORITATIVE_EMAIL=true
GOOGLE_MAX_NEW_ACCOUNTS_PER_IP=3
GOOGLE_MAX_NEW_ACCOUNTS_PER_HOUR=30
# Only when a trusted edge proxy (nginx, load balancer) sets X-Forwarded-For: its addresses, comma separated.
# Never list the Next.js /api proxy. Must be a real process environment variable when config is cached.
TRUSTED_PROXIES=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@knowledgehub.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TOKEN=
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-flash

VITE_APP_NAME="${APP_NAME}"
